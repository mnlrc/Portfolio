---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../../config/site';

/**
 * Looks for src/assets/profile.{jpg,jpeg,png,webp,avif}. If none exists yet,
 * renders a monogram so the layout stays intact.
 */
const candidates = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/profile.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photo = Object.values(candidates)[0]?.default;
const initials = site.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<div class="frame">
  {photo ? (
    <Image
      src={photo}
      alt={site.photoAlt}
      widths={[240, 480, 720]}
      sizes="(min-width: 64rem) 22rem, 60vw"
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
  ) : (
    <div class="monogram mono" role="img" aria-label={site.photoAlt}>
      {initials}
    </div>
  )}
</div>

<style>
  .frame {
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
  }

  .monogram {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: var(--text-2xl);
    color: var(--color-text-muted);
  }
</style>
